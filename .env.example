# ---------------------------------------------------------------------------
# Deployment configuration for docker-compose-deploy.yml.
# Copy this file to `.env` next to the compose file, fill in the values,
# then run:
#   docker compose -f docker-compose-deploy.yml up -d --build
#
# One Linux box. A Caddy reverse proxy (see Caddyfile) is the only public
# entry point and serves everything over HTTPS on these ports:
#   https://SERVER_HOST:8085   the web app (open this in the browser)
#   https://SERVER_HOST:8086   Spring API
#   https://SERVER_HOST:9085   Keycloak (login, admin console)
#   https://SERVER_HOST:9015   MinIO (video uploads and playback)
# plus 80 and 443 for the certificate challenge and a redirect to :8085.
# Open all six ports in the server's firewall.
# ---------------------------------------------------------------------------

# --- Public surface -------------------------------------------------------
# Hostname or IP users will reach the server at. Required. Examples:
#   - Public domain:    SERVER_HOST=klub.example.hu  or  klubnev.duckdns.org
#   - LAN IP:           SERVER_HOST=10.0.0.50
#   - Same-box only:    SERVER_HOST=localhost
# Write it exactly as users type it in the browser: the certificate, the login
# redirect and the CORS rules all check this exact name (no http://, no port).
#
# This value is used in the URLs the workers + Spring hand back to the
# browser (tracking JSON, HLS playlists, OIDC issuer, etc.), in Spring's
# and MinIO's CORS allowlist, and in the Keycloak web client's redirect
# URIs. The SPA itself does NOT need this — it auto-detects the host from
# `window.location` at runtime, so the frontend image works unmodified
# regardless of which IP the box ends up on.
#
# Keycloak reads the redirect URIs only when it first imports the realm.
# Changing SERVER_HOST on an existing install also needs the web client's
# redirect URIs and web origins updated in the Keycloak admin console
# (Clients > football-web-client). The same goes for an install made before
# HTTPS: there they still start with http:// and must be changed to https://.
SERVER_HOST=localhost

# --- HTTPS certificate ----------------------------------------------------
# HTTPS is required: logins and tokens must not travel in clear text, and the
# sport medical upload refuses to work without it. CADDY_TLS picks the certificate:
#
# 1) With a public domain name (recommended for real users):
#      CADDY_TLS=you@example.com     (any working e-mail: Let's Encrypt sends expiry notices there)
#    Caddy gets a free Let's Encrypt certificate for SERVER_HOST and renews it by
#    itself. Browsers trust it, nothing to install. Needs:
#      - SERVER_HOST is a domain name (not an IP) whose DNS A record points to this
#        server's public IP. A free option: a DuckDNS subdomain (duckdns.org,
#        e.g. klubnev.duckdns.org), set up in a few minutes.
#      - Ports 80 and 443 reachable from the internet (router port forwarding and
#        firewall), at least while the certificate is issued and renewed.
#    If it fails, `docker compose -f docker-compose-deploy.yml logs proxy` says why
#    (usually DNS not pointing here yet, or port 80/443 blocked).
#
# 2) Without a domain (IP address, closed network, testing):
#      CADDY_TLS=internal
#    Caddy signs the certificate with its own local CA. The traffic is encrypted,
#    but browsers show a "not secure" warning until the CA's root certificate is
#    installed on each device. Get it with:
#      docker compose -f docker-compose-deploy.yml cp proxy:/data/caddy/pki/authorities/local/root.crt ./caddy-root.crt
#    and install caddy-root.crt as a trusted root (Windows: double click > Install
#    Certificate > Local Machine > Trusted Root Certification Authorities; Android
#    and iOS: Settings > Security > install certificate). Fine for a few club
#    machines; for parents' phones get a domain and use option 1.
#
# The certificates and the internal CA live in the caddy_data volume: keep it.
# Removing it makes a new CA, whose root must be installed again everywhere.
CADDY_TLS=internal

# --- Secrets (all required) -----------------------------------------------
POSTGRES_PASSWORD=change-me
RABBITMQ_PASSWORD=change-me
RABBITMQ_ERLANG_COOKIE=change-me-to-32-random-chars
MINIO_ROOT_PASSWORD=change-me-min-8-chars
# minio-setup.sh creates (or updates) the Spring service account from these two
# and exits when either is empty. Use a unique secret, never a dev value.
MINIO_ACCESS_KEY=SPRING_BOOT_USER
MINIO_SECRET_KEY=change-me
# A second account for the Python workers. It reaches the video, stream, tracking
# and clip buckets only, not the medical and club document ones. Must differ from
# the Spring account.
MINIO_WORKER_ACCESS_KEY=WORKER_USER
MINIO_WORKER_SECRET_KEY=change-me
# Shared secret between MinIO and Spring for the "video uploaded" webhook
# (POST /api/webhooks/minio is not behind a login, this is its only guard).
MINIO_WEBHOOK_TOKEN=change-me-32-random-chars
# Static KMS key for the encrypted medical-docs bucket: <name>:<base64 of 32 random bytes>,
# e.g. football-key:$(head -c 32 /dev/urandom | base64). Back it up; losing it loses the files.
MINIO_KMS_SECRET_KEY=
# The proxy gives MinIO an https address, so the strict medical storage check passes.
# Set it to false only knowingly, for a demo without the proxy.
# MEDICAL_STRICT_STORAGE=false
# Only once the approved agreement text exists; a new version must be accepted by every club again.
# MEDICAL_DPA_VERSION=
# MEDICAL_DPA_DOCUMENT_URL=
# MEDICAL_NOTICE_TEMPLATE_URL=
KEYCLOAK_ADMIN_PASSWORD=change-me
# Secret of football-admin-client, the client Spring manages users with. Keycloak
# takes it from here when it first imports the realm, and Spring uses the same
# value. On an existing install, change it in the Keycloak admin console too
# (Clients > football-admin-client > Credentials), or the two stop matching.
KEYCLOAK_ADMIN_CLIENT_SECRET=change-me-32-random-chars

# --- First platform admin -------------------------------------------------
# The deploy realm has no users. When both are set and no admin exists yet,
# the backend creates this account in Keycloak on startup, and Keycloak asks
# for a new password at the first login. Remove both after that login.
INITIAL_ADMIN_EMAIL=
# At least 10 characters, and not the e-mail address: the realm's password policy refuses
# anything weaker, and then the admin is not created.
INITIAL_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# E-mail (Keycloak): e-mail verification and "forgot password".
# Any SMTP account works, for example:
#   Gmail:   smtp.gmail.com, port 587, STARTTLS; user = the Gmail address,
#            password = an app password (Google account > Security > 2-Step Verification
#            > App passwords; the normal Gmail password does not work).
#   Brevo:   smtp-relay.brevo.com, port 587, STARTTLS; user and SMTP key from the Brevo dashboard.
#   Mailjet: in-v3.mailjet.com, port 587, STARTTLS; API key as user, secret key as password.
#   Port 465 instead of 587: KEYCLOAK_SMTP_STARTTLS=false and KEYCLOAK_SMTP_SSL=true.
# KEYCLOAK_SMTP_FROM must be an address the provider lets you send from (for Gmail: the same address).
# Turn KEYCLOAK_EMAIL_ENABLED on only once the SMTP values work: with it on, a user must click
# the link in a verification e-mail before the first login, so without working e-mail nobody gets in.
# Test it in the Keycloak admin console: Realm settings > Email > Test connection.
# The realm is imported only into an empty Keycloak: on a running one, change these in that
# same console page instead (or start from an empty Keycloak database).
# ---------------------------------------------------------------------------
KEYCLOAK_EMAIL_ENABLED=false
KEYCLOAK_SMTP_HOST=
KEYCLOAK_SMTP_PORT=587
KEYCLOAK_SMTP_FROM=
KEYCLOAK_SMTP_FROM_NAME=Football Analysis
KEYCLOAK_SMTP_USER=
KEYCLOAK_SMTP_PASSWORD=
KEYCLOAK_SMTP_STARTTLS=true
KEYCLOAK_SMTP_SSL=false
