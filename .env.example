# ---------------------------------------------------------------------------
# Deployment configuration for docker-compose-deploy.yml. Copy this file to
# `.env` in the same directory, fill in the values, then run:
#   docker compose -f docker-compose-deploy.yml up -d --build
# ---------------------------------------------------------------------------

# --- Public surface -------------------------------------------------------
# Bare domain (no scheme, no trailing slash). The compose builds the four
# public hostnames as:
#   kixify.hu, www.kixify.hu, api.kixify.hu, auth.kixify.hu, minio.kixify.hu
# All five DNS records must resolve to this server's public IP before first
# boot (otherwise Caddy's ACME challenges fail when SCHEME=https).
DOMAIN=kixify.hu

# `https` enables Caddy's auto-TLS (Let's Encrypt). `http` skips TLS entirely
# — useful for staging / local-IP-only deploys without a real DNS setup.
# When toggling between the two, you MUST also flip PUBLIC_PORT and
# KEYCLOAK_HOSTNAME_STRICT_HTTPS below to match.
SCHEME=https

# Match SCHEME: 443 for https, 80 for http. The Python workers + Spring use
# this to construct browser-facing URLs; the omit-default-port logic
# (see python/ml/util/minio_client.py) drops it from the URL when it matches
# the scheme default.
PUBLIC_PORT=443

# Match SCHEME: `true` for https, `false` for http. Keycloak refuses to
# serve over http when this is true, even if the proxy forwards https
# headers — leaving it true with SCHEME=http will produce 403s in the
# login flow.
KEYCLOAK_HOSTNAME_STRICT_HTTPS=true

# Optional. Let's Encrypt sends expiry warnings here. Only used when
# SCHEME=https — leave blank for http deploys. (You can also remove the
# `email` line in the Caddyfile global block and let Caddy register
# anonymously.)
CADDY_ACME_EMAIL=

# --- Secrets (all required) -----------------------------------------------
POSTGRES_PASSWORD=change-me
RABBITMQ_PASSWORD=change-me
RABBITMQ_ERLANG_COOKIE=change-me-to-32-random-chars
MINIO_ROOT_PASSWORD=change-me-min-8-chars
# These two must match the service account created in minio-setup.sh.
# If you change them here, also edit the script before first boot.
MINIO_ACCESS_KEY=SPRING_BOOT_USER
MINIO_SECRET_KEY=change-me
KEYCLOAK_ADMIN_PASSWORD=change-me
KEYCLOAK_ADMIN_CLIENT_SECRET=change-me-32-random-chars
