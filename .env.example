# ---------------------------------------------------------------------------
# Deployment configuration for docker-compose-deploy.yml.
# Copy this file to `.env` next to the compose file, fill in the values,
# then run:
#   docker compose -f docker-compose-deploy.yml up -d --build
#
# This config targets a single Linux box on a closed network (e.g. a
# university LAN) over plain HTTP — no domain name, no TLS, no reverse
# proxy. Each public-facing service publishes its own port.
# ---------------------------------------------------------------------------

# --- Public surface -------------------------------------------------------
# Hostname or IP users will reach the server at. Anything works as long as
# the SPA can reach it from a browser:
#   - LAN IP:           SERVER_HOST=10.0.0.50
#   - University DNS:   SERVER_HOST=demo.uni.local
#   - Same-box only:    SERVER_HOST=localhost
#
# This value is used in the URLs the workers + Spring hand back to the
# browser (tracking JSON, HLS playlists, OIDC issuer, etc.), in Spring's
# and MinIO's CORS allowlist, and in the Keycloak web client's redirect
# URIs. The SPA itself does NOT need this — it auto-detects the host from
# `window.location` at runtime, so the frontend image works unmodified
# regardless of which IP the box ends up on.
#
# Keycloak reads the redirect URIs only when it first imports the realm.
# Changing SERVER_HOST on an existing install also needs the web client's
# redirect URIs and web origins updated in the Keycloak admin console.
SERVER_HOST=localhost

# --- Secrets (all required) -----------------------------------------------
POSTGRES_PASSWORD=change-me
RABBITMQ_PASSWORD=change-me
RABBITMQ_ERLANG_COOKIE=change-me-to-32-random-chars
MINIO_ROOT_PASSWORD=change-me-min-8-chars
# minio-setup.sh creates (or updates) the Spring service account from these two
# and exits when either is empty. Use a unique secret, never a dev value.
MINIO_ACCESS_KEY=SPRING_BOOT_USER
MINIO_SECRET_KEY=change-me
# A second account for the Python workers. It reaches the video, stream, tracking
# and clip buckets only, not the medical and club document ones. Must differ from
# the Spring account.
MINIO_WORKER_ACCESS_KEY=WORKER_USER
MINIO_WORKER_SECRET_KEY=change-me
# Shared secret between MinIO and Spring for the "video uploaded" webhook
# (POST /api/webhooks/minio is not behind a login, this is its only guard).
MINIO_WEBHOOK_TOKEN=change-me-32-random-chars
# Static KMS key for the encrypted medical-docs bucket: <name>:<base64 of 32 random bytes>,
# e.g. football-key:$(head -c 32 /dev/urandom | base64). Back it up; losing it loses the files.
MINIO_KMS_SECRET_KEY=
# Only for a local demo over http, set knowingly: false lets medical files in without https.
# MEDICAL_STRICT_STORAGE=false
# Only once the approved agreement text exists; a new version must be accepted by every club again.
# MEDICAL_DPA_VERSION=
# MEDICAL_DPA_DOCUMENT_URL=
# MEDICAL_NOTICE_TEMPLATE_URL=
KEYCLOAK_ADMIN_PASSWORD=change-me
# Secret of football-admin-client, the client Spring manages users with. Keycloak
# takes it from here when it first imports the realm, and Spring uses the same
# value. On an existing install, change it in the Keycloak admin console too
# (Clients > football-admin-client > Credentials), or the two stop matching.
KEYCLOAK_ADMIN_CLIENT_SECRET=change-me-32-random-chars

# --- First platform admin -------------------------------------------------
# The deploy realm has no users. When both are set and no admin exists yet,
# the backend creates this account in Keycloak on startup, and Keycloak asks
# for a new password at the first login. Remove both after that login.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
