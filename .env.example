# ---------------------------------------------------------------------------
# Deployment configuration for docker-compose-deploy.yml.
# Copy this file to `.env` next to the compose file, fill in the values,
# then run:
#   docker compose -f docker-compose-deploy.yml up -d --build
#
# This config targets a single Linux box on a closed network (e.g. a
# university LAN) over plain HTTP — no domain name, no TLS, no reverse
# proxy. Each public-facing service publishes its own port.
# ---------------------------------------------------------------------------

# --- Public surface -------------------------------------------------------
# Hostname or IP users will reach the server at. Anything works as long as
# the SPA can reach it from a browser:
#   - LAN IP:           SERVER_HOST=10.0.0.50
#   - University DNS:   SERVER_HOST=demo.uni.local
#   - Same-box only:    SERVER_HOST=localhost
#
# This value is used in the URLs the workers + Spring hand back to the
# browser (tracking JSON, HLS playlists, OIDC issuer, etc.) AND in Spring's
# CORS allowlist. The SPA itself does NOT need this — it auto-detects the
# host from `window.location` at runtime, so the frontend image works
# unmodified regardless of which IP the box ends up on.
SERVER_HOST=localhost

# --- Secrets (all required) -----------------------------------------------
POSTGRES_PASSWORD=change-me
RABBITMQ_PASSWORD=change-me
RABBITMQ_ERLANG_COOKIE=change-me-to-32-random-chars
MINIO_ROOT_PASSWORD=change-me-min-8-chars
# minio-setup.sh creates (or updates) the Spring service account from these two
# and exits when either is empty. Use a unique secret, never a dev value.
MINIO_ACCESS_KEY=SPRING_BOOT_USER
MINIO_SECRET_KEY=change-me
# Static KMS key for the encrypted medical-docs bucket: <name>:<base64 of 32 random bytes>,
# e.g. football-key:$(head -c 32 /dev/urandom | base64). Back it up; losing it loses the files.
MINIO_KMS_SECRET_KEY=
# Only for a local demo over http, set knowingly: false lets medical files in without https.
# MEDICAL_STRICT_STORAGE=false
# Only once the approved agreement text exists; a new version must be accepted by every club again.
# MEDICAL_DPA_VERSION=
# MEDICAL_DPA_DOCUMENT_URL=
# MEDICAL_NOTICE_TEMPLATE_URL=
KEYCLOAK_ADMIN_PASSWORD=change-me
KEYCLOAK_ADMIN_CLIENT_SECRET=change-me-32-random-chars
