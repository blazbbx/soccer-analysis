# Production build values — baked in at `npm run build` time. Public URLs only;
# no secrets here (Vite bundles `VITE_*` into the SPA, which is shipped to the
# browser). Override personal values via `.env.production.local`.
VITE_API_BASE_URL=https://api.kixify.hu
VITE_KEYCLOAK_AUTHORITY=https://auth.kixify.hu/realms/football-realm
VITE_FRONTEND_URL=https://kixify.hu